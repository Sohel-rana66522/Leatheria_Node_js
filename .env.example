# Firebase Web SDK config for the "leatheria" Firebase project.
# These are the SAME public values already hard-coded in the Flutter app's
# lib/main.dart — they are safe to expose to the browser (this is normal for
# Firebase's client SDK; access control is enforced by Firestore/Storage
# security rules, not by hiding this config).
#
# Copy this file to .env.local and fill in the real values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=leatheria.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=leatheria
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=leatheria.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# No Firebase Admin / service-account secrets are required for this app.
# Every Firestore read/write this app performs (products, banners, users,
# orders) uses the public Web SDK, exactly like the existing Flutter app —
# see MIGRATION_PLAN.md §5.6 for why real Firebase Authentication / Admin
# credentials were intentionally NOT introduced here.
